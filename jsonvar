_jv-encode-variables() {
        local name=$1
        local -n ref=$name
        case "${ref@a}" in
                *a*) # process indexed array
                        echo -n '['
                        local value i=0 
                        for value in "${!ref[@]}"; do
                            ((i++)) # TODO: Serialize
                            _jv-json-encode-string "$value"
                            if ((i < ${ref[@]})); then
                                echo -n ','
                            fi
                        done
                        echo -n ']'
                        ;;
                *A*) # process associative array
                        echo -n '['
                        local key value i=0
                        for key in "${!ref[@]}"; do
                                (((i++))
                                _jv-json-encode-string "$value"
                                value=${ref[$key]}
                                echo "$key: $value"
                        done
                        ;;
                *i*) # process integer
                        echo "$ref"
                        ;;
                *) # anything else, it's probably a string tbh
                        echo "'$ref'" 
                        ;;
        esac
}





