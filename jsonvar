_jv-json-encode-string() {
        local s=$1
        local LC_ALL=C
        local -A table=()
        local hex
        local byte
        local esc
        for((i = 1; i < 0x20; i++)); do
            printf -v hex '02%x' "$i"
            printf -v byte '%b' "$i"
            printf -v esc '\\u%04x' "$i"
            table[$byte]=$esc
        done
        table[$'\b']='\b'
        table[$'\t']='\t'
        table[$'\n']='\n'
        table[$'\f']='\f'
        table[$'\r']='\r'
        table['\']='\\'
        table['"']='\"'

        #serialize the string
        local out=''

        local len=${#s}
        local c
        for((i = 0; i < len; i++)); do
            c=${s:i:1}
            esc=${table[$c]}

            if [[ -n $esc ]]; then
                # lookup table match for this btye
                out+=$esc
            else
                # no lookup table match, byte falls through
                out+=$c
            fi

            echo "$c"
        done
        printf "%s\n" "$out"

}
